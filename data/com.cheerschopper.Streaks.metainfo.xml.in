<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.cheerschopper.Streaks</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Streaks</name>
  <summary>Keep track of things you do regularly</summary>
  <description>
    <p>Streaks helps you keep track of things you want to do regularly. Whether it's daily habits like exercise or cutting your nails, weekly goals like going to the gym, or special challenges like 75Hard, Streaks helps you maintain your streaks and see your progress.</p>
  </description>
  <url type="homepage">https://github.com/cheerschopper/streaks</url>
  <launchable type="desktop-id">com.cheerschopper.Streaks.desktop</launchable>
  <releases>
    <release version="0.1.0" date="2026-09-19">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1" />
  <developer id="com.cheerschopper">
    <name>Cheers Chopper</name>
  </developer>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <supports>
    <internet>offline-only</internet>
  </supports>
</component>
