using Gtk 4.0;

template $StreaksCatchupRow : Gtk.Box {
  orientation: vertical;
  overflow: hidden;

  styles ["card", "catchup-day"]

  Gtk.Box header {
    orientation: horizontal;
    spacing: 12;

    styles ["header"]

    Gtk.Box {
      orientation: vertical;
      hexpand: true;
      valign: center;
      spacing: 2;

      Gtk.Label date_label {
        halign: start;
        xalign: 0;
        ellipsize: end;

        styles ["heading", "date"]
      }

      Gtk.Label state_label {
        halign: start;
        xalign: 0;

        styles ["caption", "status"]
      }
    }

    Gtk.Button action_button {
      valign: center;
      visible: false;

      styles ["flat", "accent"]
    }
  }

  Gtk.Separator {}

  Gtk.ListBox goals_list {
    selection-mode: none;
    show-separators: true;

    styles ["catchup-goals"]
  }
}
