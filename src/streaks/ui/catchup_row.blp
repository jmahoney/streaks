using Gtk 4.0;

template $StreaksCatchupRow : Gtk.ListBoxRow {
  styles ["catchup-row"]

  child: Gtk.Box {
    orientation: vertical;
    margin-start: 16;
    margin-end: 16;
    margin-top: 12;
    margin-bottom: 12;
    spacing: 10;

    Gtk.Box {
      orientation: horizontal;
      spacing: 12;

      Gtk.Box {
        orientation: vertical;
        hexpand: true;
        valign: center;
        spacing: 2;

        Gtk.Label date_label {
          halign: start;
          xalign: 0;
          ellipsize: end;

          styles ["heading", "date"]
        }

        Gtk.Label state_label {
          halign: start;
          xalign: 0;

          styles ["caption", "dim-label"]
        }
      }

      Gtk.Box {
        orientation: horizontal;
        valign: center;

        styles ["linked"]

        Gtk.ToggleButton kept_button {
          label: _("Kept");
        }

        Gtk.ToggleButton missed_button {
          label: _("Missed");
        }
      }
    }

    Gtk.Revealer goals_revealer {
      reveal-child: false;
      transition-type: slide_down;

      child: Gtk.Box {
        orientation: vertical;
        spacing: 9;

        Gtk.ListBox goals_list {
          selection-mode: none;

          styles ["catchup-goal-list"]
        }

        Gtk.Label warning_label {
          halign: start;
          xalign: 0;
          wrap: true;
          visible: false;

          styles ["caption", "error"]
        }
      };
    }
  };
}
