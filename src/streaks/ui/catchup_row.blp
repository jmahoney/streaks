using Gtk 4.0;

template $StreaksCatchupRow : Gtk.Box {
  orientation: vertical;

  styles ["card", "catchup-day"]

  Gtk.Box header {
    orientation: horizontal;
    margin-top: 10;
    margin-bottom: 10;
    margin-start: 16;
    margin-end: 16;
    spacing: 12;

    styles ["header"]

    Gtk.Box {
      orientation: vertical;
      hexpand: true;
      valign: center;
      spacing: 2;

      Gtk.Label date_label {
        halign: start;
        xalign: 0;
        ellipsize: end;

        styles ["heading", "date"]
      }

      Gtk.Label state_label {
        halign: start;
        xalign: 0;

        styles ["caption", "status"]
      }
    }

    Gtk.Button action_button {
      valign: center;
      visible: false;

      styles ["flat", "accent"]
    }
  }

  Gtk.ListBox goals_list {
    selection-mode: none;
    activate-on-single-click: true;
  }
}
