using Gtk 4.0;
using Adw 1;

template $StreaksCatchupDialog : Adw.Dialog {
  content-width: 560;
  title: _("Catch up");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      title-widget: Adw.WindowTitle dialog_title {
        title: _("Catch up");
      };

      [start]
      Gtk.Button cancel_button {
        label: _("Cancel");
      }

      [end]
      Gtk.Button save_button {
        label: _("Save");
        sensitive: false;

        styles ["suggested-action"]
      }
    }

    content: Gtk.ScrolledWindow {
      hscrollbar-policy: never;
      propagate-natural-height: true;
      vexpand: true;

      child: Gtk.Box {
        orientation: vertical;
        valign: start;
        spacing: 12;
        margin-start: 18;
        margin-end: 18;
        margin-top: 18;
        margin-bottom: 18;

        Gtk.Label intro_label {
          halign: fill;
          xalign: 0;
          wrap: true;
          label: _("Unticked goals on a day with any ticks are recorded as missed. Days with no ticks stay unconfirmed.");

          styles ["caption", "dim-label"]
        }

        Gtk.Box days_box {
          orientation: vertical;
          spacing: 12;
        }

        Gtk.Box {
          orientation: vertical;

          styles ["card"]

          Gtk.Box {
            orientation: vertical;
            spacing: 10;
            margin-top: 14;
            margin-bottom: 14;
            margin-start: 16;
            margin-end: 16;

            Gtk.Label result_title {
              halign: start;
              xalign: 0;
              label: _("Result of these answers");

              styles ["heading"]
            }

            $StripWidget result_strip {
              halign: start;
              cell-width: 9;
              cell-height: 20;
              gap: 3;
            }

            Gtk.Label result_label {
              halign: fill;
              xalign: 0;
              wrap: true;

              styles ["caption"]
            }
          }
        }
      };
    };
  };
}
